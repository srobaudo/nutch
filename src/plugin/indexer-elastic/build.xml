<project name="indexer-elastic" default="jar-core">

  <import file="../build-plugin.xml" />

  <!-- Add compilation dependencies to classpath -->
  <path id="plugin.deps">
    <pathelement location="${build.dir}/test/conf"/>
  </path>

  <!-- Deploy Unit test dependencies -->
  <target name="deps-test">
  </target>

  <!-- Integration test targets -->
  <target name="integration-test-detect-env" description="Detect if running in GitHub Actions or locally">
    <!-- Import environment variables -->
    <property environment="env"/>
    
    <!-- Check if we're running in GitHub Actions -->
    <condition property="github.actions" value="true">
      <or>
        <isset property="env.GITHUB_ACTIONS"/>
        <equals arg1="${env.GITHUB_ACTIONS}" arg2="true"/>
      </or>
    </condition>
    
    <!-- Set default ports for local testing -->
    <property name="es8.port" value="9200"/>
    <property name="es9.port" value="9201"/>
    
    <condition property="use.github.services" value="true">
      <istrue value="${github.actions}"/>
    </condition>
    
    <condition property="skip.docker.compose" value="true">
      <istrue value="${github.actions}"/>
    </condition>
    
    <echo message="GitHub Actions detected: ${github.actions}"/>
    <echo message="Using GitHub Actions services: ${use.github.services}"/>
    <echo message="Skip Docker Compose: ${skip.docker.compose}"/>
  </target>

  <target name="integration-test-start-es" depends="integration-test-detect-env" 
          unless="skip.docker.compose" description="Start Elasticsearch containers for local integration testing">
    <echo message="Starting Elasticsearch containers for local integration testing..."/>
    <exec executable="docker" dir="${basedir}" failonerror="true">
      <arg value="compose"/>
      <arg value="-f"/>
      <arg value="docker-compose-elasticsearch.yml"/>
      <arg value="up"/>
      <arg value="-d"/>
    </exec>
    <echo message="Waiting for Elasticsearch containers to be ready..."/>
    <sleep seconds="30"/>
    <!-- Wait for ES8 -->
    <waitfor maxwait="120" maxwaitunit="second" checkevery="5" checkeveryunit="second">
      <http url="http://localhost:${es8.port}/_cluster/health"/>
    </waitfor>
    <!-- Wait for ES9 -->
    <waitfor maxwait="120" maxwaitunit="second" checkevery="5" checkeveryunit="second">
      <http url="http://localhost:${es9.port}/_cluster/health"/>
    </waitfor>
    <echo message="Elasticsearch containers are ready for testing"/>
  </target>

  <target name="integration-test-stop-es" depends="integration-test-detect-env" 
          unless="skip.docker.compose" description="Stop Elasticsearch containers">
    <echo message="Stopping Elasticsearch containers..."/>
    <exec executable="docker" dir="${basedir}" failonerror="false">
      <arg value="compose"/>
      <arg value="-f"/>
      <arg value="docker-compose-elasticsearch.yml"/>
      <arg value="down"/>
      <arg value="-v"/>
    </exec>
    <echo message="Elasticsearch containers stopped"/>
  </target>

  <target name="integration-test-wait-github-services" depends="integration-test-detect-env"
          if="use.github.services" description="Wait for GitHub Actions Elasticsearch services to be ready">
    <echo message="Waiting for GitHub Actions Elasticsearch services to be ready..."/>
    <echo message="ES8 service: localhost:${es8.port}"/>
    <echo message="ES9 service: localhost:${es9.port}"/>
    
    <!-- Wait for ES8 service -->
    <waitfor maxwait="120" maxwaitunit="second" checkevery="5" checkeveryunit="second">
      <http url="http://localhost:${es8.port}/_cluster/health"/>
    </waitfor>
    <!-- Wait for ES9 service -->
    <waitfor maxwait="120" maxwaitunit="second" checkevery="5" checkeveryunit="second">
      <http url="http://localhost:${es9.port}/_cluster/health"/>
    </waitfor>
    <echo message="GitHub Actions Elasticsearch services are ready for testing"/>
  </target>

  <target name="integration-test-check-docker" depends="integration-test-detect-env"
          unless="skip.docker.compose" description="Check if Docker and Docker Compose are available for local testing">
    <echo message="Checking Docker availability for local testing..."/>
    <exec executable="docker" outputproperty="docker.version" failonerror="false" resultproperty="docker.result">
      <arg value="--version"/>
    </exec>
    <fail message="Docker is not available. Please install Docker to run integration tests locally.">
      <condition>
        <not><equals arg1="${docker.result}" arg2="0"/></not>
      </condition>
    </fail>
    
    <exec executable="docker" outputproperty="docker-compose.version" failonerror="false" resultproperty="docker-compose.result">
      <arg value="compose"/>
      <arg value="version"/>
    </exec>
    <fail message="Docker Compose is not available. Please install Docker Compose to run integration tests locally.">
      <condition>
        <not><equals arg1="${docker-compose.result}" arg2="0"/></not>
      </condition>
    </fail>
    
    <echo message="Docker version: ${docker.version}"/>
    <echo message="Docker Compose version: ${docker-compose.version}"/>
  </target>

  <target name="integration-test-setup" depends="integration-test-detect-env, integration-test-check-docker, integration-test-start-es, integration-test-wait-github-services"
          description="Setup Elasticsearch instances for integration testing">
    <echo message="Elasticsearch setup completed"/>
  </target>

  <target name="integration-test-pre-check" depends="integration-test-setup"
          description="Pre-test connectivity check for Elasticsearch services">
    <echo message="Performing pre-test connectivity check..."/>
    
    <!-- Check ES8 connectivity -->
    <echo message="Testing connectivity to ES8 at localhost:${es8.port}"/>
    <get src="http://localhost:${es8.port}/_cluster/health" 
         dest="${build.test}/es8-health.json" 
         ignoreerrors="false" 
         verbose="true"/>
    <loadfile property="es8.health" srcFile="${build.test}/es8-health.json"/>
    <echo message="ES8 Health: ${es8.health}"/>
    
    <!-- Check ES9 connectivity -->
    <echo message="Testing connectivity to ES9 at localhost:${es9.port}"/>
    <get src="http://localhost:${es9.port}/_cluster/health" 
         dest="${build.test}/es9-health.json" 
         ignoreerrors="false" 
         verbose="true"/>
    <loadfile property="es9.health" srcFile="${build.test}/es9-health.json"/>
    <echo message="ES9 Health: ${es9.health}"/>
    
    <echo message="Pre-test connectivity check completed successfully"/>
  </target>

  <target name="integration-test" depends="compile-test, integration-test-pre-check" 
          description="Run integration tests against real Elasticsearch instances">
    <echo message="Running integration tests against Elasticsearch 8 and 9..."/>
    <condition property="env.description" value="GitHub Actions services" else="local Docker containers">
      <istrue value="${use.github.services}"/>
    </condition>
    <echo message="Testing environment: ${env.description}"/>
    
    <junit showoutput="yes" printsummary="yes" haltonfailure="no" fork="yes" maxmemory="256m"
           timeout="300000" errorProperty="tests.failed" failureProperty="tests.failed">
      <sysproperty key="test.data" value="${build.test}/data"/>
      <sysproperty key="test.input" value="${root}/data"/>
      <sysproperty key="javax.xml.parsers.DocumentBuilderFactory" value="com.sun.org.apache.xerces.internal.jaxp.DocumentBuilderFactoryImpl"/>
      <!-- Set Elasticsearch ports for tests --> 
      <sysproperty key="elasticsearch8.port" value="${es8.port}"/>
      <sysproperty key="elasticsearch9.port" value="${es9.port}"/>
      <classpath refid="test.classpath"/>
      <formatter type="${test.junit.output.format}" />
      <test name="org.apache.nutch.indexwriter.elastic.TestElasticIndexWriterIntegration" todir="${build.test}"/>
    </junit>

    <!-- Always stop containers if running locally, even if tests fail -->
    <condition property="should.stop.containers">
      <not><istrue value="${skip.docker.compose}"/></not>
    </condition>
    <antcall target="integration-test-stop-es">
      <param name="skip.docker.compose" value="${skip.docker.compose}"/>
    </antcall>

    <fail if="tests.failed">Integration tests failed!</fail>
    <echo message="Integration tests completed successfully"/>
  </target>
  
  <target name="integration-test-es8-only" depends="compile-test, integration-test-pre-check" 
          description="Run integration tests against Elasticsearch 8 only">
    <echo message="Running integration tests against Elasticsearch 8 only..."/>
    <condition property="env.description" value="GitHub Actions services" else="local Docker containers">
      <istrue value="${use.github.services}"/>
    </condition>
    <echo message="Testing environment: ${env.description}"/>
    
    <junit showoutput="yes" printsummary="yes" haltonfailure="no" fork="yes" maxmemory="256m"
           timeout="180000" errorProperty="tests.failed" failureProperty="tests.failed">
      <sysproperty key="test.data" value="${build.test}/data"/>
      <sysproperty key="test.input" value="${root}/data"/>
      <sysproperty key="javax.xml.parsers.DocumentBuilderFactory" value="com.sun.org.apache.xerces.internal.jaxp.DocumentBuilderFactoryImpl"/>
      <sysproperty key="elasticsearch8.port" value="${es8.port}"/>
      <sysproperty key="elasticsearch9.port" value="${es9.port}"/>
      <classpath refid="test.classpath"/>
      <formatter type="${test.junit.output.format}" />
      <test name="org.apache.nutch.indexwriter.elastic.TestElasticIndexWriterIntegration" 
            methods="testElasticsearch8Integration" todir="${build.test}"/>
    </junit>

    <!-- Always stop containers if running locally, even if tests fail -->
    <condition property="should.stop.containers">
      <not><istrue value="${skip.docker.compose}"/></not>
    </condition>
    <antcall target="integration-test-stop-es">
      <param name="skip.docker.compose" value="${skip.docker.compose}"/>
    </antcall>

    <fail if="tests.failed">ES8 integration test failed!</fail>
    <echo message="ES8 integration test completed successfully"/>
  </target>
  
  <target name="test-connectivity" depends="compile-test, integration-test-pre-check" 
          description="Run simple connectivity test without Nutch dependencies">
    <echo message="Running simple connectivity test..."/>
    <condition property="env.description" value="GitHub Actions services" else="local Docker containers">
      <istrue value="${use.github.services}"/>
    </condition>
    <echo message="Testing environment: ${env.description}"/>
    
    <junit showoutput="yes" printsummary="yes" haltonfailure="no" fork="yes" maxmemory="256m"
           timeout="120000" errorProperty="tests.failed" failureProperty="tests.failed">
      <sysproperty key="elasticsearch8.port" value="${es8.port}"/>
      <sysproperty key="elasticsearch9.port" value="${es9.port}"/>
      <classpath refid="test.classpath"/>
      <formatter type="${test.junit.output.format}" />
      <test name="org.apache.nutch.indexwriter.elastic.TestElasticConnectivity" todir="${build.test}"/>
    </junit>

    <fail if="tests.failed">Connectivity test failed!</fail>
    <echo message="Connectivity test completed successfully"/>
  </target>

  <target name="test-all" depends="test, integration-test" 
          description="Run both unit tests and integration tests">
    <echo message="All tests completed successfully"/>
  </target>


</project>
